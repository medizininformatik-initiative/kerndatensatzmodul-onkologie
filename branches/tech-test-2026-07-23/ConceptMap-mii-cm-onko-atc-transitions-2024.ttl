  fhir:DomainResource.text [
     fhir:Narrative.status [ fhir:value "generated" ] ;
     fhir:Narrative.div "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p class=\"res-header-id\"><b>Generated Narrative: ConceptMap mii-cm-onko-atc-transitions-2024</b></p><a name=\"mii-cm-onko-atc-transitions-2024\"> </a><a name=\"hcmii-cm-onko-atc-transitions-2024\"> </a><p>Mapping from <a href=\"ValueSet-mii-vs-onko-systemische-therapie-substanzen-2023.html\">MII VS Onkologie Systemische Therapie Substanzen ATC 2023</a> to <a href=\"ValueSet-mii-vs-onko-systemische-therapie-substanzen-2024.html\">MII VS Onkologie Systemische Therapie Substanzen ATC 2024</a></p><br/><p>Mapping from <a href=\"https://simplifier.net/resolve?scope=de.basisprofil.r4@1.5.4&amp;canonical=http://fhir.de/CodeSystem/bfarm/atc\">ATC</a> to <a href=\"https://simplifier.net/resolve?scope=de.basisprofil.r4@1.5.4&amp;canonical=http://fhir.de/CodeSystem/bfarm/atc\">ATC</a></p><table class=\"grid\"><tr><td><b>Source Code</b></td><td><b>Relationship</b></td><td><b>Target Code</b></td><td><b>Comment</b></td></tr><tr><td>L04AA34 (Alemtuzumab)</td><td><a href=\"http://hl7.org/fhir/R5/codesystem-concept-map-relationship.html#equivalent\" title=\"equivalent\">is equivalent to</a></td><td>L04AG06 (Alemtuzumab)</td><td>Reklassifizierung innerhalb der Immunsuppressiva</td></tr><tr><td>L04AA26 (Belimumab)</td><td><a href=\"http://hl7.org/fhir/R5/codesystem-concept-map-relationship.html#equivalent\" title=\"equivalent\">is equivalent to</a></td><td>L04AG04 (Belimumab)</td><td/></tr><tr><td>L04AA25 (Eculizumab)</td><td><a href=\"http://hl7.org/fhir/R5/codesystem-concept-map-relationship.html#equivalent\" title=\"equivalent\">is equivalent to</a></td><td>L04AJ01 (Eculizumab)</td><td>Reklassifizierung zu Komplement-Inhibitoren</td></tr><tr><td>L04AA21 (Efalizumab)</td><td><a href=\"http://hl7.org/fhir/R5/codesystem-concept-map-relationship.html#equivalent\" title=\"equivalent\">is equivalent to</a></td><td>L04AG02 (Efalizumab)</td><td/></tr><tr><td>L01EG02 (Everolimus)</td><td><a href=\"http://hl7.org/fhir/R5/codesystem-concept-map-relationship.html#equivalent\" title=\"equivalent\">is equivalent to</a></td><td>L04AH02 (Everolimus)</td><td>Zusätzliche Klassifizierung als Immunsuppressivum (behält auch L01EG02)</td></tr><tr><td>L04AA27 (Fingolimod)</td><td><a href=\"http://hl7.org/fhir/R5/codesystem-concept-map-relationship.html#equivalent\" title=\"equivalent\">is equivalent to</a></td><td>L04AE01 (Fingolimod)</td><td>Reklassifizierung zu Sphingosin-1-Phosphat-Rezeptor-Modulatoren</td></tr><tr><td>L04AA13 (Leflunomid)</td><td><a href=\"http://hl7.org/fhir/R5/codesystem-concept-map-relationship.html#equivalent\" title=\"equivalent\">is equivalent to</a></td><td>L04AK01 (Leflunomid)</td><td/></tr><tr><td>L01FX24 (Mosunetuzumab)</td><td><a href=\"http://hl7.org/fhir/R5/codesystem-concept-map-relationship.html#equivalent\" title=\"equivalent\">is equivalent to</a></td><td>L01FX25 (Mosunetuzumab)</td><td>Code-Anpassung innerhalb der bispezifischen Antikörper</td></tr><tr><td>L04AA02 (Muromonab-CD3)</td><td><a href=\"http://hl7.org/fhir/R5/codesystem-concept-map-relationship.html#equivalent\" title=\"equivalent\">is equivalent to</a></td><td>L04AG01 (Muromonab-CD3)</td><td/></tr><tr><td>L04AA23 (Natalizumab)</td><td><a href=\"http://hl7.org/fhir/R5/codesystem-concept-map-relationship.html#equivalent\" title=\"equivalent\">is equivalent to</a></td><td>L04AG03 (Natalizumab)</td><td/></tr><tr><td>L01XY03 (Nivolumab und Relatlimab)</td><td><a href=\"http://hl7.org/fhir/R5/codesystem-concept-map-relationship.html#equivalent\" title=\"equivalent\">is equivalent to</a></td><td>L01FY02 (Nivolumab und Relatlimab)</td><td>Reklassifizierung zu Kombinationen monoklonaler Antikörper</td></tr><tr><td>L01FA02 (Ofatumumab)</td><td><a href=\"http://hl7.org/fhir/R5/codesystem-concept-map-relationship.html#equivalent\" title=\"equivalent\">is equivalent to</a></td><td>L04AG12 (Ofatumumab)</td><td>Zusätzliche Klassifizierung als Immunsuppressivum (behält auch L01FA02)</td></tr><tr><td>L01XY02 (Pertuzumab und Trastuzumab)</td><td><a href=\"http://hl7.org/fhir/R5/codesystem-concept-map-relationship.html#equivalent\" title=\"equivalent\">is equivalent to</a></td><td>L01FY01 (Pertuzumab und Trastuzumab)</td><td>Reklassifizierung zu Kombinationen monoklonaler Antikörper</td></tr><tr><td>L04AA10 (Sirolimus)</td><td><a href=\"http://hl7.org/fhir/R5/codesystem-concept-map-relationship.html#equivalent\" title=\"equivalent\">is equivalent to</a></td><td>L04AH01 (Sirolimus)</td><td>Reklassifizierung zu mTOR-Inhibitoren (Immunsuppressiva)</td></tr></table></div>"
