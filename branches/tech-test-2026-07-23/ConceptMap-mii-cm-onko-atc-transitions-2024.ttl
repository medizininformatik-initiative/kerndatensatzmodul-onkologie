  fhir:ConceptMap.description [ fhir:value "Diese ConceptMap dokumentiert die ATC-Code-Änderungen von 2023 zu 2024. Mehrere immunmodulatorische Substanzen wurden in neue Kategorien umklassifiziert, und Kombinationspräparate erhielten neue Codes."] ;
  fhir:ConceptMap.purpose [ fhir:value "Migration von ATC-Codes für immunmodulatorische Substanzen und Kombinationspräparate, die 2024 umkodiert wurden."] ;
