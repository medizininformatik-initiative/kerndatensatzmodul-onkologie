  <concept>
    <code value="0"/>
    <display value="Totenschein"/>
  </concept>
  <concept>
    <code value="1"/>
    <display value="klinisch"/>
    <definition value="Die Diagnose wurde vor dem Tode gestellt, jedoch ohne die folgenden Maßnahmen (Schlüsselnummern 2 - 7)."/>
  </concept>
  <concept>
    <code value="2"/>
    <display value="klinische Diagnostik"/>
    <definition value="Alle Untersuchungstechniken, einschließlich Röntgen, Endoskopie, bildgebender Verfahren, Ultraschall, explorativer Eingriffe (wie Laparotomie) und Autopsie, aber ohne Gewebsuntersuchung."/>
  </concept>
  <concept>
    <code value="4"/>
    <display value="spezifische Tumor-Marker"/>
    <definition value="Zusätzlich biochemische und/oder immunologische Marker, die für einen bestimmten Tumorsitz spezifisch sind."/>
  </concept>
  <concept>
    <code value="5"/>
    <display value="Zytologie"/>
    <definition value="Untersuchung von Zellen aus einem primären oder sekundären Sitz, einschließlich der aus durch Endoskopie oder durch Punktion gewonnenen Aspiraten; beinhaltet auch die mikroskopische Untersuchung peripheren Blutes und von Knochenmarkspunktaten."/>
  </concept>
  <concept>
    <code value="6"/>
    <display value="histologische Untersuchung einer Metastase"/>
    <definition value="Histologische Untersuchung des Gewebes aus einer Metastase, inklusive der Untersuchung von Proben aus einer Autopsie."/>
  </concept>
  <concept>
    <code value="7"/>
    <display value="histologische Untersuchung eines Primärtumors"/>
    <definition value="Histologische Untersuchung des Gewebes aus einem Primärtumor, gleich wie es gewonnen wurde; inklusive aller Schnitt-Techniken und Knochenmarksbiopsien; schließt auch die Untersuchung von Proben des Primärtumors aus einer Autopsie ein."/>
  </concept>
  <concept>
    <code value="7.1"/>
    <display value="histologische Untersuchung eines Primärtumors"/>
    <definition value="Histologische Untersuchung des Gewebes aus einem Primärtumor, gleich wie es gewonnen wurde; inklusive aller Schnitt-Techniken und Knochenmarksbiopsien; schließt auch die Untersuchung von Proben des Primärtumors aus einer Autopsie ein."/>
  </concept>
  <concept>
    <code value="7.2"/>
    <display value="histologische Untersuchung einer Metastase"/>
    <definition value="Histologische Untersuchung des Gewebes aus einer Metastase, inklusive der Untersuchung von Proben aus einer Autopsie."/>
  </concept>
  <concept>
    <code value="7.3"/>
    <display value="Histologie der Autopsie"/>
    <definition value="Histologische Untersuchung von Tumorgewebe gleich wie es gewonnen wurde; inklusive aller Schnitt-Techniken und Knochenmarksbiopsien"/>
  </concept>
  <concept>
    <code value="8"/>
    <display value="Zytogenetisch und/oder molekularer Test"/>
    <definition value="Nachweis von tumorspezifischen genetischen Anomalien und genetischen Veränderungen im Tumor einschließlich Verfahren wie Karyotypisierung, FISH (Fluoreszenz in situ-Hybridisierung), PCR"/>
  </concept>
  <concept>
    <code value="9"/>
    <display value="unbekannt"/>
  </concept>
