        "path": "Observation.code.coding",
        "sliceName": "loinc",
        "min": 1,
        "max": "*",
        "patternCoding": {
          "code": "21889-1",
          "system": "http://loinc.org",
          "display": "Size Tumor"
        },
        "mustSupport": true
      },
      {
        "id": "Observation.code.coding:loinc.system",
        "path": "Observation.code.coding.system",
        "min": 1,
        "mustSupport": true
      },
