msgstr ""

# CodeSystem.concept.display
#: CodeSystem.concept.display
msgid "Totenschein"
msgstr ""

# CodeSystem.concept.display
#: CodeSystem.concept.display
msgid "klinisch"
msgstr ""

# CodeSystem.concept.definition
#: CodeSystem.concept.definition
msgid "Die Diagnose wurde vor dem Tode gestellt, jedoch ohne die folgenden Maßnahmen (Schlüsselnummern 2 - 7)."
msgstr ""

# CodeSystem.concept.display
#: CodeSystem.concept.display
msgid "klinische Diagnostik"
msgstr ""

# CodeSystem.concept.definition
#: CodeSystem.concept.definition
msgid "Alle Untersuchungstechniken, einschließlich Röntgen, Endoskopie, bildgebender Verfahren, Ultraschall, explorativer Eingriffe (wie Laparotomie) und Autopsie, aber ohne Gewebsuntersuchung."
msgstr ""

# CodeSystem.concept.display
#: CodeSystem.concept.display
msgid "spezifische Tumor-Marker"
msgstr ""

# CodeSystem.concept.definition
#: CodeSystem.concept.definition
msgid "Zusätzlich biochemische und/oder immunologische Marker, die für einen bestimmten Tumorsitz spezifisch sind."
msgstr ""

# CodeSystem.concept.display
#: CodeSystem.concept.display
msgid "Zytologie"
msgstr ""

# CodeSystem.concept.definition
#: CodeSystem.concept.definition
msgid "Untersuchung von Zellen aus einem primären oder sekundären Sitz, einschließlich der aus durch Endoskopie oder durch Punktion gewonnenen Aspiraten; beinhaltet auch die mikroskopische Untersuchung peripheren Blutes und von Knochenmarkspunktaten."
msgstr ""

# CodeSystem.concept.display
#: CodeSystem.concept.display
msgid "histologische Untersuchung einer Metastase"
msgstr ""

# CodeSystem.concept.definition
#: CodeSystem.concept.definition
msgid "Histologische Untersuchung des Gewebes aus einer Metastase, inklusive der Untersuchung von Proben aus einer Autopsie."
msgstr ""

# CodeSystem.concept.display
#: CodeSystem.concept.display
msgid "histologische Untersuchung eines Primärtumors"
msgstr ""

# CodeSystem.concept.definition
#: CodeSystem.concept.definition
msgid "Histologische Untersuchung des Gewebes aus einem Primärtumor, gleich wie es gewonnen wurde; inklusive aller Schnitt-Techniken und Knochenmarksbiopsien; schließt auch die Untersuchung von Proben des Primärtumors aus einer Autopsie ein."
msgstr ""

# CodeSystem.concept.display
#: CodeSystem.concept.display
msgid "Histologie der Autopsie"
msgstr ""

# CodeSystem.concept.definition
#: CodeSystem.concept.definition
msgid "Histologische Untersuchung von Tumorgewebe gleich wie es gewonnen wurde; inklusive aller Schnitt-Techniken und Knochenmarksbiopsien"
msgstr ""

# CodeSystem.concept.display
#: CodeSystem.concept.display
msgid "Zytogenetisch und/oder molekularer Test"
msgstr ""

# CodeSystem.concept.definition
#: CodeSystem.concept.definition
msgid "Nachweis von tumorspezifischen genetischen Anomalien und genetischen Veränderungen im Tumor einschließlich Verfahren wie Karyotypisierung, FISH (Fluoreszenz in situ-Hybridisierung), PCR"
msgstr ""

# CodeSystem.concept.display
#: CodeSystem.concept.display
msgid "unbekannt"
msgstr ""

