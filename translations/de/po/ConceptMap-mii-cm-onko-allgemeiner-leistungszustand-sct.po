# ConceptMap.group.element.display
#: ConceptMap.group.element.display
msgid "Normale, uneingeschränkte Aktivität wie vor der Erkrankung (90 - 100 % nach Karnofsky)"
msgstr ""

# ConceptMap.group.element.target.display
#: ConceptMap.group.element.target.display
msgid "Eastern Cooperative Oncology Group performance status - grade 0 (finding)"
msgstr ""

# ConceptMap.group.element.display
#: ConceptMap.group.element.display
msgid "Einschränkung bei körperlicher Anstrengung, aber gehfähig; leichte körperliche Arbeit bzw. Arbeit im Sitzen (z. B. leichte Hausarbeit oder Büroarbeit) möglich (70 - 80 % nach Karnofsky)"
msgstr ""

# ConceptMap.group.element.target.display
#: ConceptMap.group.element.target.display
msgid "Eastern Cooperative Oncology Group performance status - grade 1 (finding)"
msgstr ""

# ConceptMap.group.element.display
#: ConceptMap.group.element.display
msgid "Gehfähig, Selbstversorgung möglich, aber nicht arbeitsfähig; kann mehr als 50 % der Wachzeit aufstehen (50 - 60 % nach Karnofsky)"
msgstr ""

# ConceptMap.group.element.target.display
#: ConceptMap.group.element.target.display
msgid "Eastern Cooperative Oncology Group performance status - grade 2 (finding)"
msgstr ""

# ConceptMap.group.element.display
#: ConceptMap.group.element.display
msgid "Nur begrenzte Selbstversorgung möglich; ist 50 % oder mehr der Wachzeit an Bett oder Stuhl gebunden (30  40 % nach Karnofsky)"
msgstr ""

# ConceptMap.group.element.target.display
#: ConceptMap.group.element.target.display
msgid "Eastern Cooperative Oncology Group performance status - grade 3 (finding)"
msgstr ""

# ConceptMap.group.element.display
#: ConceptMap.group.element.display
msgid "Völlig pflegebedürftig, keinerlei Selbstversorgung möglich; völlig an Bett oder Stuhl gebunden (10 - 20 % nach Karnofsky)"
msgstr ""

# ConceptMap.group.element.target.display
#: ConceptMap.group.element.target.display
msgid "Eastern Cooperative Oncology Group performance status - grade 4 (finding)"
msgstr ""

