# CodeSystem.concept.display
#: CodeSystem.concept.display
msgid "Anämie"
msgstr ""

# CodeSystem.concept.definition
#: CodeSystem.concept.definition
msgid "Eine Störung, die durch eine Verminderung der Menge des Hämoglobins in 100 ml Blut gekennzeichnet ist. Zeichen und Symptome der Anämie können Blässe der Haut und der Schleimhäute, Kurzatmigkeit, Herzklopfen, weiche systolische Geräusche, Trägheit und Ermüdbarkeit einschließen."
msgstr ""

# CodeSystem.concept.designation.value
#: CodeSystem.concept.designation.value
msgid "Blutarmut"
msgstr ""

# CodeSystem.concept.display
#: CodeSystem.concept.display
msgid "Disseminierte intravaskuläre Koagulation"
msgstr ""

# CodeSystem.concept.definition
#: CodeSystem.concept.definition
msgid "Eine Störung, die durch eine systemische krankhafte Aktivierung der Blutgerinnungsmechanismen gekennzeichnet ist und Gerinnselbildung im ganzen Körper zur Folge hat. Es existiert ein erhöhtes Blutungsrisikos, da der Körper an Blutplättchen und Gerinnungsfaktoren verarmt ist."
msgstr ""

# CodeSystem.concept.designation.value
#: CodeSystem.concept.designation.value
msgid "Gerinnungsstörung"
msgstr ""

# CodeSystem.concept.designation.value
#: CodeSystem.concept.designation.value
msgid "disseminierte intravasale Koagulopathie"
msgstr ""

# CodeSystem.concept.designation.value
#: CodeSystem.concept.designation.value
msgid "ausgedehnte intravaskuläre Koagulation"
msgstr ""

# CodeSystem.concept.display
#: CodeSystem.concept.display
msgid "Fieberhafte Neutropenie"
msgstr ""

# CodeSystem.concept.definition
#: CodeSystem.concept.definition
msgid "Eine Störung, die durch eine absolute Neutrophilenanzahl von <1000/mm3 und einer einmaligen Temperatur von >38.3 Grad C oder einer anhaltenden Tempaeratur von >=38 Grad C für länger als eine Stunde gekennzeichnet ist."
msgstr ""

# CodeSystem.concept.display
#: CodeSystem.concept.display
msgid "Hämolyse"
msgstr ""

# CodeSystem.concept.definition
#: CodeSystem.concept.definition
msgid "Eine Störung, die als Ergebnis einer Laboruntersuchung durch eine verbreitete Membranzerstörung von Erythrozyten gekennzeichnet ist."
msgstr ""

# CodeSystem.concept.designation.value
#: CodeSystem.concept.designation.value
msgid "Blutauflösung"
msgstr ""

# CodeSystem.concept.designation.value
#: CodeSystem.concept.designation.value
msgid "Transfusionszwischenfall"
msgstr ""

# CodeSystem.concept.display
#: CodeSystem.concept.display
msgid "Hämolytischurämisches Syndrom (HUS)"
msgstr ""

# CodeSystem.concept.definition
#: CodeSystem.concept.definition
msgid "Eine Störung, die durch eine Form der thrombotischen Mikroangiopathie mit Nierenversagen, hämolytischer Anämie und schwerer Thrombozytopenie gekennzeichnet ist."
msgstr ""

# CodeSystem.concept.display
#: CodeSystem.concept.display
msgid "Hypozelluläres Knochenmark"
msgstr ""

# CodeSystem.concept.designation.value
#: CodeSystem.concept.designation.value
msgid "Zellarmes Knochenmark"
msgstr ""

# CodeSystem.concept.designation.value
#: CodeSystem.concept.designation.value
msgid "Knochenmarkhypozellularität"
msgstr ""

# CodeSystem.concept.display
#: CodeSystem.concept.display
msgid "Leukozytose"
msgstr ""

# CodeSystem.concept.definition
#: CodeSystem.concept.definition
msgid "Eine Störung, gekennzeichnet durch Laboruntersuchungen, die eine erhöhte Anzahl weißer Zellen im Blut anzeigen."
msgstr ""

# CodeSystem.concept.designation.value
#: CodeSystem.concept.designation.value
msgid "Erhöhung der weißen Blutkörperchen"
msgstr ""

# CodeSystem.concept.display
#: CodeSystem.concept.display
msgid "Lymphknotenschmerzen"
msgstr ""

# CodeSystem.concept.definition
#: CodeSystem.concept.definition
msgid "Eine Störung, die durch das Gefühl deutlicher Beschwerden in einem Lymphknoten gekennzeichnet ist."
msgstr ""

# CodeSystem.concept.designation.value
#: CodeSystem.concept.designation.value
msgid "-"
msgstr ""

# CodeSystem.concept.display
#: CodeSystem.concept.display
msgid "Milzerkrankung"
msgstr ""

# CodeSystem.concept.definition
#: CodeSystem.concept.definition
msgid "Eine Erkrankung der Milz."
msgstr ""

# CodeSystem.concept.designation.value
#: CodeSystem.concept.designation.value
msgid "Störung der Milzfunktion"
msgstr ""

# CodeSystem.concept.designation.value
#: CodeSystem.concept.designation.value
msgid "Erkrankung der Milz"
msgstr ""

# CodeSystem.concept.display
#: CodeSystem.concept.display
msgid "Thrombotische thrombozytopenische Purpura"
msgstr ""

# CodeSystem.concept.definition
#: CodeSystem.concept.definition
msgid "Eine Störung, gekennzeichnet durch das Vorhandensein einer mikroangiopathischen hämolytischen Anämie, thrombozytopenischen Purpura, Fieber, renaler Abnormitäten und neurologischer Abnormitäten wie Krämpfe, Halbseitenlähmung und Sehstörungen. Es handelt sich um eine akute oder subakute Situation."
msgstr ""

# CodeSystem.concept.designation.value
#: CodeSystem.concept.designation.value
msgid "Thrombotischthrombozytopenische Purpura"
msgstr ""

# CodeSystem.concept.designation.value
#: CodeSystem.concept.designation.value
msgid "Moschcowitz Syndrom"
msgstr ""

# CodeSystem.concept.designation.value
#: CodeSystem.concept.designation.value
msgid "TTP"
msgstr ""

# CodeSystem.concept.display
#: CodeSystem.concept.display
msgid "Störungen des Blut- und Lymphsystems - Sonstige, zu spezifizieren"
msgstr ""

# CodeSystem.concept.definition
#: CodeSystem.concept.definition
msgid "Sonstige zu spezifizierende Störungen des hämatopoietischen und/oder lymphoiden Gewebes."
msgstr ""

# CodeSystem.concept.designation.value
#: CodeSystem.concept.designation.value
msgid "Störungen des hämatopoietischen und lymphoiden Systems"
msgstr ""

# CodeSystem.concept.display
#: CodeSystem.concept.display
msgid "Akutes Koronarsyndrom"
msgstr ""

# CodeSystem.concept.definition
#: CodeSystem.concept.definition
msgid "Eine Störung, gekennzeichnet durch Zeichen und Symptome, verbunden mit einer akuten Ischämie des Herzmuskels als Folge einer koronaren Herzerkrankung. Die klinische Präsentation deckt ein Spektrum von Herzerkrankungen von der instabilen Angina pectoris bis zum Myokardinfarkt ab"
msgstr ""

# CodeSystem.concept.designation.value
#: CodeSystem.concept.designation.value
msgid "Akute Herzstörung"
msgstr ""

# CodeSystem.concept.display
#: CodeSystem.concept.display
msgid "Aortenklappenkrankheit"
msgstr ""

# CodeSystem.concept.definition
#: CodeSystem.concept.definition
msgid "Eine Störung, gekennzeichnet durch einen Defekt der Aortenklappenfunktion oder Struktur."
msgstr ""

# CodeSystem.concept.designation.value
#: CodeSystem.concept.designation.value
msgid "Aortenklappenstenose"
msgstr ""

# CodeSystem.concept.designation.value
#: CodeSystem.concept.designation.value
msgid "Aortenklappeninsuffizienz"
msgstr ""

# CodeSystem.concept.display
#: CodeSystem.concept.display
msgid "Asystolie"
msgstr ""

# CodeSystem.concept.definition
#: CodeSystem.concept.definition
msgid "Eine Störung, gekennzeichnet durch eine Dysrhythmie ohne kardiale elektrische Aktivität. Typischerweise ist dies begleitet von einer Beendigung der Pumpfunktion des Herzens."
msgstr ""

# CodeSystem.concept.designation.value
#: CodeSystem.concept.designation.value
msgid "Herzstillstand"
msgstr ""

# CodeSystem.concept.designation.value
#: CodeSystem.concept.designation.value
msgid "Herzrhythmusstörung"
msgstr ""

# CodeSystem.concept.display
#: CodeSystem.concept.display
msgid "AV Block ersten Grades"
msgstr ""

# CodeSystem.concept.definition
#: CodeSystem.concept.definition
msgid "Eine Störung, gekennzeichnet durch eine Dysrhythmie mit einer Zeitverzögerung die für Leitung eines elektrischen Impulses durch den atrioventrikulären (AV)-Knoten über 0.2 Sekunden benötigt wird; Verlängerung des PR-Intervalls größer als 200 Millisekunden."
msgstr ""

# CodeSystem.concept.display
#: CodeSystem.concept.display
msgid "AV Block, Mobitz Typ II"
msgstr ""

# CodeSystem.concept.definition
#: CodeSystem.concept.definition
msgid "Eine Störung, gekennzeichnet durch eine Dysrhythmie mit relativ konstanten PR Intervallen vor dem Block eines atrialen Impulses. Dies ist das Ergebnis eines intermittierenden Versagens des atrialen elektrischen Impulses durch den AV-Knoten zu den Kammern."
msgstr ""

# CodeSystem.concept.display
#: CodeSystem.concept.display
msgid "AV Block, vollständiger"
msgstr ""

# CodeSystem.concept.definition
#: CodeSystem.concept.definition
msgid "Eine Störung, gekennzeichnet durch eine Dysrhythmie mit komplettem Versagen der atrialen elektrischen Impulsleitung durch den AV-Knoten zu den Kammern."
msgstr ""

# CodeSystem.concept.designation.value
#: CodeSystem.concept.designation.value
msgid "Kompletter AV'-Block"
msgstr ""

# CodeSystem.concept.display
#: CodeSystem.concept.display
msgid "Herzbeuteltamponade"
msgstr ""

# CodeSystem.concept.definition
#: CodeSystem.concept.definition
msgid "Eine Störung, gekennzeichnet durch einen Anstieg des intraperikardialen Drucks aufgrund der Ansammlung von Blut oder Flüssigkeit im Perikard (genauer: Herzbeutel)."
msgstr ""

# CodeSystem.concept.display
#: CodeSystem.concept.display
msgid "Herzbeutelentzündung"
msgstr ""

# CodeSystem.concept.definition
#: CodeSystem.concept.definition
msgid "Eine Störung, gekennzeichnet durch eine Reizung der Schichten des Perikards (dem schützenden Beutel um das Herz)."
msgstr ""

# CodeSystem.concept.designation.value
#: CodeSystem.concept.designation.value
msgid "Perikarditis"
msgstr ""

# CodeSystem.concept.display
#: CodeSystem.concept.display
msgid "Herzbeutelerguss"
msgstr ""

# CodeSystem.concept.definition
#: CodeSystem.concept.definition
msgid "Eine Störung, gekennzeichnet durch Flüssigkeitsansammlung im Herzbeutel, in der Regel aufgrund einer Entzündung."
msgstr ""

# CodeSystem.concept.designation.value
#: CodeSystem.concept.designation.value
msgid "Perikarderguss"
msgstr ""

# CodeSystem.concept.display
#: CodeSystem.concept.display
msgid "Herzklopfen"
msgstr ""

# CodeSystem.concept.definition
#: CodeSystem.concept.definition
msgid "Eine Störung, gekennzeichnet durch eine unangenehme Empfindung von irregulärem und/oder kräftigem Klopfen des Herzens."
msgstr ""

# CodeSystem.concept.designation.value
#: CodeSystem.concept.designation.value
msgid "Palpitationen"
msgstr ""

# CodeSystem.concept.designation.value
#: CodeSystem.concept.designation.value
msgid "Herzrasen"
msgstr ""

# CodeSystem.concept.display
#: CodeSystem.concept.display
msgid "Herzstillstand"
msgstr ""

# CodeSystem.concept.definition
#: CodeSystem.concept.definition
msgid "Eine Störung, gekennzeichnet durch einen Stillstand der Pumpfunktion des Herzens."
msgstr ""

# CodeSystem.concept.designation.value
#: CodeSystem.concept.designation.value
msgid "Kardialer Stillstand"
msgstr ""

# CodeSystem.concept.display
#: CodeSystem.concept.display
msgid "Herzversagen"
msgstr ""

# CodeSystem.concept.definition
#: CodeSystem.concept.definition
msgid "Eine Störung, gekennzeichnet durch das Unvermögen des Herzens, Blut in einem angemessenen Volumen zu pumpen, um die Gewebestoffwechselbedürfnisse zu gewährleisten, oder die Fähigkeit, dies lediglich durch eine Anhebung des Fülldrucks zu erreichen."
msgstr ""

# CodeSystem.concept.designation.value
#: CodeSystem.concept.designation.value
msgid "Herzinsuffizienz"
msgstr ""

# CodeSystem.concept.designation.value
#: CodeSystem.concept.designation.value
msgid "Herzfehler"
msgstr ""

# CodeSystem.concept.designation.value
#: CodeSystem.concept.designation.value
msgid "Kardiogener Schock"
msgstr ""

# CodeSystem.concept.display
#: CodeSystem.concept.display
msgid "Kammerflimmern"
msgstr ""

# CodeSystem.concept.definition
#: CodeSystem.concept.definition
msgid "Eine Störung, gekennzeichnet durch eine Dysrhythmie ohne erkennbare QRS Komplexe aufgrund schneller repetitiver Erregung der Muskelfasern ohne koordinierte Kontraktion der Kammern."
msgstr ""

# CodeSystem.concept.designation.value
#: CodeSystem.concept.designation.value
msgid "Ventrikuläres Flimmern"
msgstr ""

# CodeSystem.concept.display
#: CodeSystem.concept.display
msgid "Kardialer Brustschmerz"
msgstr ""

# CodeSystem.concept.definition
#: CodeSystem.concept.definition
msgid "Eine Störung, gekennzeichnet durch substernales Missempfinden aufgrund unzureichender myokardialer Sauerstoffversorgung."
msgstr ""

# CodeSystem.concept.designation.value
#: CodeSystem.concept.designation.value
msgid "Angiona pectoris Schmerz"
msgstr ""

# CodeSystem.concept.designation.value
#: CodeSystem.concept.designation.value
msgid "Kardialer Thoraxschmerz"
msgstr ""

# CodeSystem.concept.display
#: CodeSystem.concept.display
msgid "Linksventrikuläre systolische Dysfunktion"
msgstr ""

# CodeSystem.concept.definition
#: CodeSystem.concept.definition
msgid "Eine Störung, gekennzeichnet durch ein Versagen des linken Ventrikels, genügenden Auswurf zu erzeugen, trotz eines Anstiegs des Ausdehnungsdrucks und des enddiastolischen Volumens. Klinische Manifestationen können Atemnot, Atemnot im Liegen und andere Zeichen pulmonaler Stauung und Ödeme."
msgstr ""

# CodeSystem.concept.designation.value
#: CodeSystem.concept.designation.value
msgid "Systolische Dysfunktion linke Herzkammer"
msgstr ""

# CodeSystem.concept.display
#: CodeSystem.concept.display
msgid "Mitralklappenerkrankung"
msgstr ""

# CodeSystem.concept.definition
#: CodeSystem.concept.definition
msgid "Eine Störung, gekennzeichnet durch einen Defekt der Mitralklappenfunktion- oder struktur."
msgstr ""

# CodeSystem.concept.designation.value
#: CodeSystem.concept.designation.value
msgid "Mitralklappeninsuffizienz"
msgstr ""

# CodeSystem.concept.designation.value
#: CodeSystem.concept.designation.value
msgid "Mitralklappenstenose"
msgstr ""

# CodeSystem.concept.designation.value
#: CodeSystem.concept.designation.value
msgid "Mitralklappenkrankheit"
msgstr ""

# CodeSystem.concept.display
#: CodeSystem.concept.display
msgid "Mobitz Typ I"
msgstr ""

# CodeSystem.concept.display
#: CodeSystem.concept.display
msgid "Myokardinfarkt"
msgstr ""

# CodeSystem.concept.definition
#: CodeSystem.concept.definition
msgid "Eine Störung, gekennzeichnet durch eine schwerwiegende Nekrose des Myokards; dies liegt an einer Unterbrechung der Blutversorgung zu diesem Bereich."
msgstr ""

# CodeSystem.concept.designation.value
#: CodeSystem.concept.designation.value
msgid "Herzinfarkt"
msgstr ""

# CodeSystem.concept.display
#: CodeSystem.concept.display
msgid "Myokarditis"
msgstr ""

# CodeSystem.concept.definition
#: CodeSystem.concept.definition
msgid "Eine Störung, gekennzeichnet durch eine Entzündung des Herzmuskelgewebes."
msgstr ""

# CodeSystem.concept.designation.value
#: CodeSystem.concept.designation.value
msgid "Herzentzündung"
msgstr ""

# CodeSystem.concept.display
#: CodeSystem.concept.display
msgid "Paroxysmale Vorhoftachykardie"
msgstr ""

# CodeSystem.concept.definition
#: CodeSystem.concept.definition
msgid "Eine Störung, gekennzeichnet durch eine Dysrhythmie mit abrupten Beginn und plötzlichem Ende von atrialen Kontraktionen mit einer Rate von 150-250 Schlägen pro Minute. Die rhythmische Störung entsteht in den Vorhöfen."
msgstr ""

# CodeSystem.concept.designation.value
#: CodeSystem.concept.designation.value
msgid "Anfallsweise Vorhoftachykardie"
msgstr ""

# CodeSystem.concept.display
#: CodeSystem.concept.display
msgid "Perikarditis, konstriktive"
msgstr ""

# CodeSystem.concept.definition
#: CodeSystem.concept.definition
msgid "Eine Störung, gekennzeichnet durch Verdickung und einem fibrotischen perikardialen Herzbeutel; diese fibrotischen Veränderungen behindern die normale myokardiale Funktion durch Einschränkung der myokardialen Funktion."
msgstr ""

# CodeSystem.concept.display
#: CodeSystem.concept.display
msgid "Pulmonalklappenerkrankung"
msgstr ""

# CodeSystem.concept.definition
#: CodeSystem.concept.definition
msgid "Eine Störung, gekennzeichnet durch einen Defekt der Pulmonaklappenfunktion- oder struktur."
msgstr ""

# CodeSystem.concept.designation.value
#: CodeSystem.concept.designation.value
msgid "Pulmonalklappenstenose"
msgstr ""

# CodeSystem.concept.designation.value
#: CodeSystem.concept.designation.value
msgid "Pulmonalklappeninsuffizienz"
msgstr ""

# CodeSystem.concept.display
#: CodeSystem.concept.display
msgid "Restriktive Kardiomyopathie"
msgstr ""

# CodeSystem.concept.definition
#: CodeSystem.concept.definition
msgid "Eine Störung, gekennzeichnet durch eine Unfähigkeit der Kammern, sich mit Blut zu füllen, weil das Myokard versteift und seine Flexibilität verliert."
msgstr ""

# CodeSystem.concept.designation.value
#: CodeSystem.concept.designation.value
msgid "RCM"
msgstr ""

# CodeSystem.concept.display
#: CodeSystem.concept.display
msgid "Rechtsventrikuläre Dysfunktion"
msgstr ""

# CodeSystem.concept.definition
#: CodeSystem.concept.definition
msgid "Eine Störung, gekennzeichnet durch ein Versagen der Funktion der rechten Kammer, assoziiert mit einer niedrigen Ejektionsfraktion und einer Verringerung in der Motilität der rechten Kammerwand."
msgstr ""

# CodeSystem.concept.designation.value
#: CodeSystem.concept.designation.value
msgid "Rechtsherzdysfunktion"
msgstr ""

# CodeSystem.concept.display
#: CodeSystem.concept.display
msgid "Sick-sinus-Syndrom"
msgstr ""

# CodeSystem.concept.definition
#: CodeSystem.concept.definition
msgid "Eine Störung, gekennzeichnet durch eine Dysrhythmie mit alternierenden Perioden von Bradykardie und atrialer Tachykardie, begleitet von Synkopen, Müdigkeit und Schwindel."
msgstr ""

# CodeSystem.concept.designation.value
#: CodeSystem.concept.designation.value
msgid "Syndrom des kranken Sinusknotens"
msgstr ""

# CodeSystem.concept.display
#: CodeSystem.concept.display
msgid "Sinusbradykardie"
msgstr ""

# CodeSystem.concept.definition
#: CodeSystem.concept.definition
msgid "Eine Störung, gekennzeichnet durch eine Dysrhythmie mit einer Herzfrequenz von weniger als 60 Schlägen pro Minute, die vom Sinusknoten stammen."
msgstr ""

# CodeSystem.concept.display
#: CodeSystem.concept.display
msgid "Sinustachykardie"
msgstr ""

# CodeSystem.concept.definition
#: CodeSystem.concept.definition
msgid "Eine Störung, gekennzeichnet durch eine Dysrhythmie mit einer Herzfrequenz  von mehr als 100 Schlägen pro Minute, die vom Sinusknoten stammen."
msgstr ""

# CodeSystem.concept.display
#: CodeSystem.concept.display
msgid "Supraventrikuläre Tachykardie"
msgstr ""

# CodeSystem.concept.definition
#: CodeSystem.concept.definition
msgid "Eine Störung, gekennzeichnet durch eine Dysrhythmie mit einer Herzfrequenz  von mehr als 100 Schlägen pro Minute, die oberhalb der Kammern entstehen."
msgstr ""

# CodeSystem.concept.display
#: CodeSystem.concept.display
msgid "Trikuspidalklappenerkrankung"
msgstr ""

# CodeSystem.concept.definition
#: CodeSystem.concept.definition
msgid "Eine Störung, gekennzeichnet durch einen Defekt der Pulmonalklappenfunktion- oder struktur."
msgstr ""

# CodeSystem.concept.designation.value
#: CodeSystem.concept.designation.value
msgid "Trikuspidalklappenstenose"
msgstr ""

# CodeSystem.concept.designation.value
#: CodeSystem.concept.designation.value
msgid "Trikuspidalklappeninsuffizienz"
msgstr ""

# CodeSystem.concept.display
#: CodeSystem.concept.display
msgid "Überleitungsstörung"
msgstr ""

# CodeSystem.concept.definition
#: CodeSystem.concept.definition
msgid "Eine Störung, gekennzeichnet durch pathologische Irregularitäten im kardialen Leitungssystem"
msgstr ""

# CodeSystem.concept.display
#: CodeSystem.concept.display
msgid "Ventrikuläre Arrhythmie"
msgstr ""

# CodeSystem.concept.definition
#: CodeSystem.concept.definition
msgid "Eine Störung, gekennzeichnet durch eine Dysrhythmie, die in den Kammern entsteht."
msgstr ""

# CodeSystem.concept.designation.value
#: CodeSystem.concept.designation.value
msgid "Kammerarhythmie"
msgstr ""

# CodeSystem.concept.display
#: CodeSystem.concept.display
msgid "Ventrikuläre Tachykardie"
msgstr ""

# CodeSystem.concept.definition
#: CodeSystem.concept.definition
msgid "Eine Störung, gekennzeichnet durch eine Dysrhythmie mit einer Herzfrequenz  von mehr als 100 Schlägen pro Minute, die distel des His'schen Bündels entsteht."
msgstr ""

# CodeSystem.concept.designation.value
#: CodeSystem.concept.designation.value
msgid "Kammertachykardie"
msgstr ""

# CodeSystem.concept.display
#: CodeSystem.concept.display
msgid "Vorhofflattern"
msgstr ""

# CodeSystem.concept.definition
#: CodeSystem.concept.definition
msgid "Eine Störung, gekennzeichnet durch eine Dysrhythmie mit organisierten rhythmischen Vorhofkontraktionen einer Rate von 200-300 Schlägen pro Minute, Die rhythmische Störung entsteht in den Vorhöfen."
msgstr ""

# CodeSystem.concept.display
#: CodeSystem.concept.display
msgid "Vorhofflimmern"
msgstr ""

# CodeSystem.concept.definition
#: CodeSystem.concept.definition
msgid "Eine Störung, gekennzeichnet durch eine Dysrhythmie ohne erkennbare P-Wellen und einer irreguläre ventrikuläre Antwort aufgrund multipler wiedereintretender Stromkreise."
msgstr ""

# CodeSystem.concept.display
#: CodeSystem.concept.display
msgid "Wolff-Parkinson-White Syndrom (WPW)"
msgstr ""

# CodeSystem.concept.definition
#: CodeSystem.concept.definition
msgid "Eine Störung, gekennzeichnet durch das Vorhandensein eines akzessorischen Leitungsweges zwischen den Vorhöfen und den Kammern, was vorzeitige ventrikuläre Aktivierungen bewirkt."
msgstr ""

# CodeSystem.concept.designation.value
#: CodeSystem.concept.designation.value
msgid "WPW'-Syndrom"
msgstr ""

# CodeSystem.concept.display
#: CodeSystem.concept.display
msgid "Herzerkrankungen - Sonstige, zu spezifizieren"
msgstr ""

# CodeSystem.concept.definition
#: CodeSystem.concept.definition
msgid "Sonstige, zu spezifizierende Herzstörungen, die als unerwünschte Ereignisse im Rahmen einer Behandlung auftreten."
msgstr ""

# CodeSystem.concept.display
#: CodeSystem.concept.display
msgid "Angeborene, familiäre und genetische Erkrankungen - Sonstige, zu spezifizieren"
msgstr ""

# CodeSystem.concept.definition
#: CodeSystem.concept.definition
msgid "Sonstige, zu spezifizierende angeborene, familiäre und genetische Störungen, die unerwünschte Ereignisse im Rahmen einer Behandlung darstellen."
msgstr ""

# CodeSystem.concept.designation.value
#: CodeSystem.concept.designation.value
msgid "Kongenitale, familiäre und vererbbare Krankheiten-Sonstige, zu spezifizieren"
msgstr ""

# CodeSystem.concept.display
#: CodeSystem.concept.display
msgid "Beeinträchtigung des Hörens"
msgstr ""

# CodeSystem.concept.definition
#: CodeSystem.concept.definition
msgid "Eine Störung, gekennzeichnet durch teilweisen oder kompletten Verlust der Fähigkeit, Schall (Töne, Geräusche) wahrzunehmen oder zu verstehen, hervorgerufen durch Verletzung/Schädigung von Ohrstrukturen."
msgstr ""

# CodeSystem.concept.designation.value
#: CodeSystem.concept.designation.value
msgid "Hörbehinderung"
msgstr ""

# CodeSystem.concept.designation.value
#: CodeSystem.concept.designation.value
msgid "Hypakusis"
msgstr ""

# CodeSystem.concept.designation.value
#: CodeSystem.concept.designation.value
msgid "Schwerhörigkeit"
msgstr ""

# CodeSystem.concept.designation.value
#: CodeSystem.concept.designation.value
msgid "Hörminderung"
msgstr ""

# CodeSystem.concept.display
#: CodeSystem.concept.display
msgid "Mittelohrentzündung"
msgstr ""

