# CodeSystem.concept.display
#: CodeSystem.concept.display
msgid "International Staging System"
msgstr ""

# CodeSystem.concept.definition
#: CodeSystem.concept.definition
msgid "Staging system for multiple myeloma based on serum beta-2 microglobulin and albumin levels."
msgstr ""

# CodeSystem.concept.display
#: CodeSystem.concept.display
msgid "ISS I"
msgstr ""

# CodeSystem.concept.definition
#: CodeSystem.concept.definition
msgid "Beta-2 microglobulin <3.5 mg/L and albumin ≥3.5 g/dL"
msgstr ""

# CodeSystem.concept.display
#: CodeSystem.concept.display
msgid "ISS II"
msgstr ""

# CodeSystem.concept.definition
#: CodeSystem.concept.definition
msgid "Not ISS I or ISS III"
msgstr ""

# CodeSystem.concept.display
#: CodeSystem.concept.display
msgid "ISS III"
msgstr ""

# CodeSystem.concept.definition
#: CodeSystem.concept.definition
msgid "Beta-2 microglobulin ≥5.5 mg/L"
msgstr ""

# CodeSystem.concept.display
#: CodeSystem.concept.display
msgid "International Scoring System for Waldenström's Macroglobulinemia"
msgstr ""

# CodeSystem.concept.definition
#: CodeSystem.concept.definition
msgid "Prognostic scoring system for Waldenström's macroglobulinemia based on age, beta-2 microglobulin, and albumin levels."
msgstr ""

# CodeSystem.concept.display
#: CodeSystem.concept.display
msgid "ISSWM Niedrig"
msgstr ""

# CodeSystem.concept.definition
#: CodeSystem.concept.definition
msgid "Low risk: age ≤65 years, beta-2 microglobulin ≤3 mg/L, albumin >3.5 g/dL"
msgstr ""

# CodeSystem.concept.display
#: CodeSystem.concept.display
msgid "ISSWM Intermediär"
msgstr ""

# CodeSystem.concept.definition
#: CodeSystem.concept.definition
msgid "Intermediate risk: one adverse factor"
msgstr ""

# CodeSystem.concept.display
#: CodeSystem.concept.display
msgid "ISSWM Hoch"
msgstr ""

# CodeSystem.concept.definition
#: CodeSystem.concept.definition
msgid "High risk: age >65 years or beta-2 microglobulin >3 mg/L, or albumin ≤3.5 g/dL (≥2 factors)"
msgstr ""

# CodeSystem.concept.display
#: CodeSystem.concept.display
msgid "WHO Grade"
msgstr ""

# CodeSystem.concept.definition
#: CodeSystem.concept.definition
msgid "World Health Organization grading system for central nervous system tumors based on histological features."
msgstr ""

# CodeSystem.concept.display
#: CodeSystem.concept.display
msgid "WHO Grad I"
msgstr ""

# CodeSystem.concept.definition
#: CodeSystem.concept.definition
msgid "Well-differentiated, slow-growing, low proliferative potential"
msgstr ""

# CodeSystem.concept.display
#: CodeSystem.concept.display
msgid "WHO Grad II"
msgstr ""

# CodeSystem.concept.definition
#: CodeSystem.concept.definition
msgid "Moderately differentiated, infiltrative, low proliferative potential"
msgstr ""

# CodeSystem.concept.display
#: CodeSystem.concept.display
msgid "WHO Grad III"
msgstr ""

# CodeSystem.concept.definition
#: CodeSystem.concept.definition
msgid "Poorly differentiated, anaplastic, high proliferative potential"
msgstr ""

# CodeSystem.concept.display
#: CodeSystem.concept.display
msgid "WHO Grad IV"
msgstr ""

# CodeSystem.concept.definition
#: CodeSystem.concept.definition
msgid "Poorly differentiated, high mitotic activity, necrosis, microvascular proliferation"
msgstr ""

