      "target" : null
    },
    {
      "id" : "CodeSystem.concept.definition",
      "context" : "CodeSystem.concept.definition",
      "source" : "Alle Untersuchungstechniken, einschließlich Röntgen, Endoskopie, bildgebender Verfahren, Ultraschall, explorativer Eingriffe (wie Laparotomie) und Autopsie, aber ohne Gewebsuntersuchung.",
