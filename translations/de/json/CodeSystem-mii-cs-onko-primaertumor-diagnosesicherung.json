    },
    {
      "id" : "CodeSystem.concept.definition",
      "context" : "CodeSystem.concept.definition",
      "source" : "Histologische Untersuchung des Gewebes aus einer Metastase, inklusive der Untersuchung von Proben aus einer Autopsie.",
      "target" : null
    },
    {
      "id" : "CodeSystem.concept.display",
      "context" : "CodeSystem.concept.display",
