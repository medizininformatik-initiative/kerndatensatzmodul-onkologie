@startuml MII_Onko_05_Diagnosis
object MII_Diagnose #FFFF66
Map 05_Diagnose #FFFF66 {
 05.1 Primärtumor Tumordiagnose ICD Code => Condition.code.coding[icd10-gm].code
 05.2 Primärtumor Tumordiagnose ICD-Version => Condition.code.coding[icd10-gm].version
 05.3 Primärtumor Tumordiagnose Text => Condition.code.text
 05.4 Primärtumor Topographie ICD O => Condition.bodySite.coding[icd-o-3].code
 05.5 Primärtumor Topographie ICD O Version => Condition.bodySite.coding[icd-o-3].version
 05.6 Primärtumor Diagnosedatum => Condition.extension[Feststellungsdatum].valueDateTime [1..1]
 05.7 Primärtumor Diagnosesicherung => Condition.verificationStatus.coding[primaertumorDiagnosesicherung].code
 05.8 Primärtumor Seitenlokalisation => Condition.bodySite.coding[primaertumorSeitenlokalisation].code
 05.9 Frühere Tumorerkrankungen => Condition.extension[occurredFollowing].valueReference
 06.3 Morphologie-Code => Condition.extension[morphology-behavior-icdo3].valueCodeableConcept.coding.code [0..*]
 06.4 Morphologie ICD-O/Blue Book Version => Condition.extension[morphology-behavior-icdo3].valueCodeableConcept.coding.version
 06.5 Morphologie-Freitext => Condition.extension[morphology-behavior-icdo3].valueCodeableConcept.text
 Tumor-ID => Condition.identifier [0..*]
}

MII_Diagnose <|-down- 05_Diagnose

object R4_Condition #EEEEEE
object Fruehere_Tumorerkrankung #FFFF66 {
    + code.text [1..1]
    + code.coding[icd10-gm] [0..1]
    + bodySite.coding[icd-o-3] [0..1]
    + extension[morphology-behavior-icdo3] [0..1]
    + extension[assertedDate] [0..1]
    + clinicalStatus [0..1]
    + category[oncology] [1..1] = SCT#394593009
}
R4_Condition <|---- Fruehere_Tumorerkrankung
05_Diagnose --> "0..*" Fruehere_Tumorerkrankung : extension[occurredFollowing]
05_Diagnose --> "0..*" 05_Diagnose : extension[occurredFollowing]
05_Diagnose --> "0..*" 05_Diagnose : extension[transformationVon]

object Ursache_dueTo #EEEEEE {
    + Ziel offen: Condition | Procedure | MedicationStatement | Immunization
}
05_Diagnose ..> "0..*" Ursache_dueTo : extension[dueTo] (Ziel offen)

object R4_List #EEEEEE
object Evidenz_Primärdiagnose #EEEEEE {
    + enthält Referenzen auf alle Beobachtungen, die zum Zeitpunkt der Diagnosestellung bekannt sind
    + soll aus Diagnosemeldung befüllt werden
}
R4_List <|---- Evidenz_Primärdiagnose
05_Diagnose --> "0..1" Evidenz_Primärdiagnose : evidence.detail

legend right 
|Color|Type|
|<#FFFF66>|Condition|
|<#CCCCFF>|CarePlan|
|<#9999FF>|Procedure|
|<#DDFFDD>|ServiceRequest|
|<#88FF88>|DiagnosticReport|
|<#22FF22>|Observation|
|<#FFCCFF>|Medication|
|<#FF9999>|AdverseEvent|
|<#44FFFF>|Specimen|
|<#EEEEEE>|List|
endlegend



@enduml