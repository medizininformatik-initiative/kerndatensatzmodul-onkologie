@startuml TNM_Breast_Cancer_Journey

left to right direction

<style>
title {
  FontSize 14
  FontStyle bold
}
</style>

skinparam defaultFontSize 11
skinparam defaultFontName "DejaVu Sans"
skinparam shadowing false

title TNM Klassifikation & Verlauf - Mammakarzinom Patientenreise (Issue #189) - Klinisches Review: Therese Pross (Brustzentrum Berlin)

' ============================================
' TNM STAGING (oBDS Kapitel 8)
' ============================================

map "**2024-01-11**\n**Initiale Diagnose**" as TP1 #FFE6E6 {
  TNM => **cT3cN1cM0**
  Stadium => **IIIA**
  T: cT3 => SCT 1352966002
  N: cN1 => SCT 1353043007
  M: cM0 <U+2190> => SCT 1352512001
  Kontext => //Klinisches TNM//\n//via Bildgebung//
}

map "**2024-02-15**\n**Nach Biopsie**" as TP2 #FFD4B8 {
  TNM => **cT4cN1cM0**
  Stadium => **IIIB**
  T: cT4 NEU => SCT 1352997003
  N: cN1 <U+2190> => (reused)
  M: cM0 <U+2190> => (reused)
  Kontext => //T bleibt klinisch!//\n//Biopsie: keine pT-Groesse//
}

map "**2024-05-20**\n**Nach Chemotherapie**" as TP3 #E6F3FF {
  TNM => **ycT2ycN0cM0**
  Stadium => **IIA**
  T: ycT2 => SCT 1352993004
  N: ycN0 => SCT 1353041009
  M: cM0 <U+2190> => (reused)
  Kontext => //y-Praefix: Post-Therapie//\n//Downstaging//
}

map "**2024-06-15**\n**Nach Operation**" as TP4 #D4EDDA {
  TNM => **ypT0ypN0cM0**
  Stadium => **X** (pCR)
  T: ypT0 => SCT 1352552004
  N: ypN0 => SCT 1352621009
  M: cM0 <U+2190> => (reused)
  L0 / V0 / Pn0 => Zusatzkategorien
  R0 => Kein Residualtumor
  Kontext => //Pathol. Komplettremission//\n//+ L, V, Pn, R//
}

map "**2027-06-20**\n**Rezidiv**" as TP5 #FFB6B6 {
  TNM => **rcT2cN1cM1**
  Stadium => **IV**
  T: rcT2 => SCT 1352993004
  N: rcN1 => SCT 1353043007
  M: rcM1 NEU => SCT 1352513006
  Kontext => //r-Praefix: Recurrence//\n//neue Baseline mit Mets//
}

TP1 --> TP2 : 5 Wochen
TP2 --> TP3 : 3 Monate
TP3 --> TP4 : 4 Wochen
TP4 --> TP5 : 3 Jahre

' ============================================
' VERLAUF / RESPONSE (oBDS Kapitel 17)
' ============================================

map "**2024-05-20**\n**Verlauf: Nach Chemo**" as VL1 #E6E6FF {
  Gesamt => **T** (Teilremission / PR)
  Primaertumor => T (Tumorreste)
  Lymphknoten => K (kein Befall)
  Fernmetastasen => K (keine)
  Kontext => //Tumor geschrumpft//\n//cT3 -> ycT2//
}

map "**2024-06-15**\n**Verlauf: Nach OP**" as VL2 #D4F5D4 {
  Gesamt => **V** (Vollremission / CR)
  Primaertumor => K (kein Tumor)
  Lymphknoten => K (kein Befall)
  Fernmetastasen => K (keine)
  Kontext => //pCR: ypT0ypN0//\n//R0-Resektion//
}

map "**2027-06-20**\n**Verlauf: Rezidiv**" as VL3 #FFD4D4 {
  Gesamt => **P** (Progression)
  Primaertumor => R (Lokalrezidiv)
  Lymphknoten => R (LK-Rezidiv)
  Fernmetastasen => R (neue Mets)
  Kontext => //Lokal + Fern//\n//neue Baseline//
}

VL1 --> VL2 : 4 Wochen
VL2 --> VL3 : 3 Jahre

' ============================================
' VERTICAL ALIGNMENT: TNM <-> Verlauf
' ============================================

TP3 -[hidden]-> VL1
TP4 -[hidden]-> VL2
TP5 -[hidden]-> VL3

legend bottom
  | Symbol | Bedeutung |
  | **<U+2190>** | Wiederverwendung der cM0 Observation aus 2024-01-11 |
  | **NEU** | Neue Observation erstellt |
  | **Praefixe** | c=Klinisch, p=Pathologisch, y=Post-Therapie, r=Rezidiv |
  | **SCT** | SNOMED CT Codes (UICC + SCT Dual-Kodierung) |
  | **L/V/Pn/R** | Zusatzkategorien nach chirurgischer Resektion |
  | **oBDS 8** | TNM-Klassifikation (obere Reihe) |
  | **oBDS 17** | Verlaufsbeurteilung (untere Reihe) |
  | **V/T/K/P/R** | Verlauf: Vollremission, Teilremission, Kein Befund, Progression, Rezidiv |
end legend

@enduml
