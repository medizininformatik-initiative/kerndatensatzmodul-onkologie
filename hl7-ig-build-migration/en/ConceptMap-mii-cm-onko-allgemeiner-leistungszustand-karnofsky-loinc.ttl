     fhir:Narrative.status [ fhir:value "generated" ] ;
     fhir:Narrative.div "<div xml:lang=\"en\" lang=\"en\"><hr/><p><b>English</b></p><hr/><p class=\"res-header-id\"><b>Generated Narrative: ConceptMap mii-cm-onko-allgemeiner-leistungszustand-karnofsky-loinc</b></p><a name=\"en-mii-cm-onko-allgemeiner-leistungszustand-karnofsky-loinc\"> </a><a name=\"en-hcmii-cm-onko-allgemeiner-leistungszustand-karnofsky-loinc\"> </a><p>Mapping from <a href=\"ValueSet-mii-vs-onko-allgemeiner-leistungszustand-karnofsky.html\">MII VS Onkologie Allgemeiner Leistungszustand nach Karnofsky</a> to <a href=\"https://loinc.org/LL4986-7\">LOINC Answer Codes for LL4986-7</a></p><br/><p>Mapping from <a href=\"CodeSystem-mii-cs-onko-allgemeiner-leistungszustand-karnofsky.html\">MII CS Onkologie Allgemeiner Leistungszustand Karnofsky</a> to <a href=\"http://terminology.hl7.org/6.5.0/CodeSystem-v3-loinc.html\">Logical Observation Identifiers, Names and Codes (LOINC)</a></p><table class=\"grid\"><tr><td><b>Source Code</b></td><td><b>Relationship</b></td><td><b>Target Code</b></td></tr><tr><td>100%</td><td><a href=\"http://hl7.org/fhir/R5/codesystem-concept-map-relationship.html#equivalent\" title=\"equivalent\">is equivalent to</a></td><td>LA29165-0 (Normal; no complaints; no evidence of disease)</td></tr><tr><td>90%</td><td><a href=\"http://hl7.org/fhir/R5/codesystem-concept-map-relationship.html#equivalent\" title=\"equivalent\">is equivalent to</a></td><td>LA29166-8 (Able to carry on normal activity; minor signs or symptoms of disease)</td></tr><tr><td>80%</td><td><a href=\"http://hl7.org/fhir/R5/codesystem-concept-map-relationship.html#equivalent\" title=\"equivalent\">is equivalent to</a></td><td>LA29167-6 (Normal activity with effort; some signs or symptoms of disease)</td></tr><tr><td>70%</td><td><a href=\"http://hl7.org/fhir/R5/codesystem-concept-map-relationship.html#equivalent\" title=\"equivalent\">is equivalent to</a></td><td>LA29168-4 (Cares for self; unable to carry on normal activity or to do active work)</td></tr><tr><td>60%</td><td><a href=\"http://hl7.org/fhir/R5/codesystem-concept-map-relationship.html#equivalent\" title=\"equivalent\">is equivalent to</a></td><td>LA29169-2 (Requires occasional assistance, but is able to care for most needs)</td></tr><tr><td>50%</td><td><a href=\"http://hl7.org/fhir/R5/codesystem-concept-map-relationship.html#equivalent\" title=\"equivalent\">is equivalent to</a></td><td>LA29170-0 (Requires considerable assistance and frequent medical care)</td></tr><tr><td>40%</td><td><a href=\"http://hl7.org/fhir/R5/codesystem-concept-map-relationship.html#equivalent\" title=\"equivalent\">is equivalent to</a></td><td>LA29171-8 (Disabled; requires special care and assistance)</td></tr><tr><td>30%</td><td><a href=\"http://hl7.org/fhir/R5/codesystem-concept-map-relationship.html#equivalent\" title=\"equivalent\">is equivalent to</a></td><td>LA29172-6 (Severely disabled; hospitalization is indicated, although death not imminent)</td></tr><tr><td>20%</td><td><a href=\"http://hl7.org/fhir/R5/codesystem-concept-map-relationship.html#equivalent\" title=\"equivalent\">is equivalent to</a></td><td>LA29173-4 (Very sick; hospitalization necessary; active supportive treatment necessary)</td></tr><tr><td>10%</td><td><a href=\"http://hl7.org/fhir/R5/codesystem-concept-map-relationship.html#equivalent\" title=\"equivalent\">is equivalent to</a></td><td>LA29174-2 (Moribund; fatal processes progressing rapidly)</td></tr><tr><td>0%</td><td><a href=\"http://hl7.org/fhir/R5/codesystem-concept-map-relationship.html#equivalent\" title=\"equivalent\">is equivalent to</a></td><td>LA9627-1 (Dead)</td></tr></table></div>"
