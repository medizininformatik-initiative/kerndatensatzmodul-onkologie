       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "MII PR Onkologie Systemische Therapie Medikation" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Medikation der Systemische Therapie. Dieses Profil beschreibt die konkreten Medikationen, die im Rahmen der systemische Therapie für den oBDS dokumentiert werden.  Da im oBDS systemische und abwartende Therapie in einem Feld gruppiert sind, werden die Daten für die Systemische und abwartende Therapie sowohl über eine FHIR-Prozedur (systemisch und abwartend) als auch als FHIR-Medikation abgedeckt." ] ;
